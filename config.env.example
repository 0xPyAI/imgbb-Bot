# ==========================================
# Telegram API Credentials (https://my.telegram.org)
# ==========================================
API_ID=12345678
API_HASH=your_api_hash_here

# ==========================================
# Telegram Bot Token (@BotFather)
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# ==========================================
# PostgreSQL Database Connection String
# Put values with special characters (such as $) in single quotes.
# With the bundled Docker Compose database, the host is "db":
#   DATABASE_URL='postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/imgbb_bot'
# ==========================================
DATABASE_URL='postgresql://postgres:postgres_password@localhost:5432/imgbb_bot'

# ==========================================
# Encryption Key for API Keys at Rest
# Generate with: python generate_key.py
# Back it up: without it, saved user keys cannot be decrypted.
# ==========================================
FERNET_KEY=your_fernet_key_here

# ==========================================
# Optional / Advanced Production Settings
# ==========================================
# Application logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum images transferred at once. Each one stays in RAM (up to 32 MB)
# from download until its imgbb upload ends, so raise this with care.
# Telegram downloads run in parallel up to this number (at most 8).
MAX_CONCURRENT_DOWNLOADS=4

# Timeout in seconds for MTProto media downloads
DOWNLOAD_TIMEOUT=60

# Directory for the Telegram bot.session file (defaults to the project directory)
# SESSION_DIR=/var/lib/pyrogrambot

# File touched every 30 s for health checks (the Docker image sets this itself)
# HEARTBEAT_FILE=/var/lib/pyrogrambot/heartbeat

# Optional Sentry DSN for error telemetry and crash reporting
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
